<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>PclFrpAddon</RootNamespace>
    <AssemblyName>PclFrpAddon</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Built by build.ps1 before this project; keeps the helper inside the addon DLL. -->
    <HelperExe>$(MSBuildThisFileDirectory)..\..\build\PclFrpHelper.exe</HelperExe>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(HelperExe)" LogicalName="PclFrpHelper.exe" Condition="Exists('$(HelperExe)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
